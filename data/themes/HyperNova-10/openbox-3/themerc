# HyperNova "Modern 10" window theme: flat white title bars, red close on hover.
border.width: 1
padding.width: 10
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.active.border.color: #1883d7
window.inactive.border.color: #aaaaaa
window.active.client.color: #ffffff
window.inactive.client.color: #ffffff

window.active.title.bg: Flat Solid
window.active.title.bg.color: #ffffff
window.active.title.separator.color: #ffffff
window.inactive.title.bg: Flat Solid
window.inactive.title.bg.color: #ffffff
window.inactive.title.separator.color: #ffffff

window.active.label.bg: Parentrelative
window.active.label.text.color: #000000
window.inactive.label.bg: Parentrelative
window.inactive.label.text.color: #999999
window.label.text.justify: Left

window.active.handle.bg: Flat Solid
window.active.handle.bg.color: #ffffff
window.active.grip.bg: Flat Solid
window.active.grip.bg.color: #ffffff
window.inactive.handle.bg: Flat Solid
window.inactive.handle.bg.color: #ffffff
window.inactive.grip.bg: Flat Solid
window.inactive.grip.bg.color: #ffffff

window.active.button.unpressed.bg: Parentrelative
window.active.button.unpressed.image.color: #000000
window.active.button.hover.bg: Flat Solid
window.active.button.hover.bg.color: #e5e5e5
window.active.button.hover.image.color: #000000
window.active.button.pressed.bg: Flat Solid
window.active.button.pressed.bg.color: #cccccc
window.active.button.pressed.image.color: #000000
window.active.button.disabled.bg: Parentrelative
window.active.button.disabled.image.color: #bbbbbb
window.active.button.toggled.bg: Parentrelative
window.active.button.toggled.image.color: #000000
window.inactive.button.unpressed.bg: Parentrelative
window.inactive.button.unpressed.image.color: #999999
window.inactive.button.hover.bg: Flat Solid
window.inactive.button.hover.bg.color: #e5e5e5
window.inactive.button.hover.image.color: #000000
window.inactive.button.pressed.bg: Flat Solid
window.inactive.button.pressed.bg.color: #cccccc
window.inactive.button.pressed.image.color: #000000
window.inactive.button.disabled.bg: Parentrelative
window.inactive.button.disabled.image.color: #cccccc
window.inactive.button.toggled.bg: Parentrelative
window.inactive.button.toggled.image.color: #999999
menu.border.width: 1
menu.border.color: #cccccc
menu.overlap.x: 0
menu.overlap.y: 0
menu.title.bg: Flat Solid
menu.title.bg.color: #f2f2f2
menu.title.text.color: #000000
menu.title.text.justify: Left
menu.items.bg: Flat Solid
menu.items.bg.color: #f2f2f2
menu.items.text.color: #000000
menu.items.disabled.text.color: #9a9a9a
menu.items.active.bg: Flat Solid
menu.items.active.bg.color: #dadada
menu.items.active.text.color: #000000
menu.separator.color: #b0b0b0
osd.border.width: 1
osd.border.color: #cccccc
osd.bg: Flat Solid
osd.bg.color: #f2f2f2
osd.label.text.color: #000000
osd.hilight.bg: Flat Solid
osd.hilight.bg.color: #dadada
osd.unhilight.bg: Flat Solid
osd.unhilight.bg.color: #f2f2f2

